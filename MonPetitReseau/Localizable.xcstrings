    },
    "help.feat.todos.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shopping, things to bring, errands — assign a task to a member to share the load."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courses, choses à apporter, démarches — assignez une tâche à un membre pour partager la charge."
          }
        }
      }
    },
