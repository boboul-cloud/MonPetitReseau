    },
    "help.hero.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay close to your loved ones, without a server, without an account, without anyone spying on you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez proches de vos proches, sans serveur, sans compte, sans que personne vous espionne."
          }
        }
      }
    },
    "help.hero.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to your family network"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans votre réseau familial"
          }
        }
      }
    },
    "help.intro.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small private space for your family: a directory, a wall to chat, photos, events and shared tasks. Everything stays on your iPhone. To exchange with your relatives, the app generates a magic link that you send by SMS — no server, no account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit espace privé pour votre famille : un annuaire, un mur pour discuter, des photos, des événements et des tâches partagées. Tout reste sur votre iPhone. Pour échanger avec vos proches, l'app génère un lien magique que vous envoyez par SMS — pas de serveur, pas de compte."
          }
        }
      }
    },
    "help.intro.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is MonPetitReseau?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est quoi MonPetitRéseau ?"
          }
        }
      }
    },
    "help.privacy.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No server, no account, no tracking. Your data lives only on your iPhone and in the share links you choose to send. Whoever has the link can see the family — share only with people you trust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de serveur, pas de compte, pas de pistage. Vos données vivent uniquement sur votre iPhone et dans les liens de partage que vous décidez d'envoyer. Qui possède le lien peut voir la famille — ne le partagez qu'avec des personnes de confiance."
          }
        }
      }
    },
    "help.privacy.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your privacy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre vie privée"
          }
        }
      }
    },
    "help.step1.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the welcome screen, fill in the family name and your first card (it's you!). You'll be able to add other members afterwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l'écran d'accueil, renseignez le nom de la famille et votre première fiche (c'est vous !). Vous pourrez ajouter les autres membres ensuite."
          }
        }
      }
    },
    "help.step1.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your family"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre famille"
          }
        }
      }
    },
    "help.step2.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Family tab, tap the + at the top right. Add a first name, an emoji, optionally a phone number, an email, the birthday and the family ties (mother, father, partner)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l'onglet Famille, touchez le + en haut à droite. Ajoutez un prénom, un emoji, éventuellement un numéro, un e-mail, la date d'anniversaire et les liens familiaux (mère, père, conjoint·e)."
          }
        }
      }
    },
    "help.step2.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your relatives"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos proches"
          }
        }
      }
    },
    "help.step3.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Settings → Share my family. A link is generated. Send it by SMS or iMessage to a relative. They open it on their iPhone (or in their browser) and instantly join your network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez dans Réglages → Partager ma famille. Un lien est généré. Envoyez-le par SMS ou iMessage à un proche. Il l'ouvre sur son iPhone (ou dans son navigateur) et rejoint instantanément votre réseau."
          }
        }
      }
    },
    "help.step3.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share with your family"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez avec votre famille"
          }
        }
      }
    },
    "help.step4.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a relative sends you a link, tap it: the app opens and merges their data with yours. You can also paste a link from Settings → Paste a link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un proche vous envoie un lien, touchez-le : l'app s'ouvre et fusionne ses données avec les vôtres. Vous pouvez aussi coller un lien depuis Réglages → Coller un lien."
          }
        }
      }
    },
    "help.step4.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive a family"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une famille"
          }
        }
      }
    },
    "help.step5.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write on the wall, post photos, schedule a Sunday lunch, assign a task to your brother — and re-share the link to publish updates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez sur le mur, publiez des photos, programmez un déjeuner du dimanche, assignez une tâche à votre frère — puis re-partagez le lien pour diffuser les mises à jour."
          }
        }
      }
    },
    "help.step5.title" : {
