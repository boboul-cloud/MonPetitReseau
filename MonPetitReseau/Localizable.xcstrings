    "help.faq.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Photos are not transmitted via the link (too heavy). Use AirDrop or iMessage for that.\n• When you change something, re-share the link so your relatives get the update.\n• Each relative can also re-share their version: incoming changes are merged with yours.\n• Tap a member then 'This is me' to identify yourself on a shared phone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Les photos ne passent pas par le lien (trop lourdes). Utilisez AirDrop ou iMessage pour ça.\n• Quand vous modifiez quelque chose, re-partagez le lien pour que vos proches reçoivent la mise à jour.\n• Chaque proche peut aussi re-partager sa version : les changements reçus sont fusionnés avec les vôtres.\n• Touchez un membre puis 'C'est moi' pour vous identifier sur un téléphone partagé."
          }
        }
      }
    },
    "help.faq.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good to know"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon à savoir"
          }
        }
      }
    },
    "help.feat.directory.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All members with their phone, email, city, family ties and upcoming birthdays."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les membres avec téléphone, e-mail, ville, liens de parenté et anniversaires à venir."
          }
        }
      }
    },
    "help.feat.directory.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family — directory"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Famille — annuaire"
          }
        }
      }
    },
    "help.feat.events.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family lunches, holidays, gatherings — and birthdays counted automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjeuners de famille, vacances, retrouvailles — et anniversaires comptés automatiquement."
          }
        }
      }
    },
    "help.feat.events.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events — calendar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événements — calendrier"
          }
        }
      }
    },
    "help.feat.photos.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shared gallery of memories. Photos stay on your iPhone (not in the share link, too heavy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une galerie partagée de souvenirs. Les photos restent sur votre iPhone (pas dans le lien de partage, trop lourdes)."
          }
        }
      }
    },
    "help.feat.photos.title" : {
